# Copy to .env (in this folder) and fill in. .env is git-ignored.

# --- Storage -------------------------------------------------------------
# Leave empty to run with in-memory storage (data is lost on restart).
DATABASE_URL=postgresql://bulbul:bulbul@localhost:5432/bulbul

# --- Phase 1 auth --------------------------------------------------------
DEV_USER_ID=dev-user
CORS_ORIGINS=http://localhost:5173

# --- Model providers (fallback order is set in backend/config/models.yaml)
# Any provider left empty is skipped. At least one is required.
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=

# --- Langfuse tracing (optional) -----------------------------------------
# Free cloud tier: https://langfuse.com/cloud  (project Settings > API Keys)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Your project's region: https://cloud.langfuse.com (EU), https://us.cloud.langfuse.com,
# https://jp.cloud.langfuse.com, or a self-hosted URL.
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Keeps dev traces out of production dashboards. docker-compose sets "docker".
LANGFUSE_TRACING_ENVIRONMENT=development

# --- Swiggy MCP (optional) ---------------------------------------------
# Empty = Swiggy off. Local stub for development (no approval needed):
#   cd backend && uv run python -m stubs.swiggy_instamart     -> http://127.0.0.1:8765
# Staging (after Swiggy allowlists your redirect URI): https://mcp-staging.swiggy.com
SWIGGY_BASE_URL=
# Where your browser reaches Bulbul; sign-in redirects come back to {PUBLIC_URL}/api/integrations/swiggy/callback
PUBLIC_URL=http://localhost:5173
# Encrypts integration tokens at rest. Generate one with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BULBUL_SECRET_KEY=

# --- Voice (voicecat) -----------------------------------------------------
# Best feel. Leave empty to use the free local voice (Whisper + Kokoro) or the browser's own.
DEEPGRAM_API_KEY=      # speech-to-text: https://console.deepgram.com
CARTESIA_API_KEY=      # voice: https://play.cartesia.ai (also set tts.cartesia.voice in voicecat/config/voice.yaml)
ELEVENLABS_API_KEY=    # alternative voice: https://elevenlabs.io

# --- Docker host ports (only if the defaults are taken) -----------------------
# BULBUL_PORT=8080         # the app: http://localhost:8080
# POSTGRES_PORT=5432       # the database, on 127.0.0.1 only
# SWIGGY_STUB_PORT=8766    # the local Swiggy stub's sign-in page
